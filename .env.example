APP_NAME="eBot CS2 Web"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_INSTALLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database - must match eBot Node.js server database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ebotv3
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# eBot Node.js Server Connection
EBOT_IP=127.0.0.1
EBOT_PORT=12360
EBOT_WEBSOCKET_URL=http://localhost:12360

# Shared secret for JWT tokens (must match eBot Node.js config)
EBOT_WEBSOCKET_SECRET_KEY=generatestrongsecretkey

# eBot file paths (relative to project root or absolute)
EBOT_LOG_MATCH_PATH=../../ebot-csgo/logs/log_match
EBOT_LOG_MATCH_ADMIN_PATH=../../ebot-csgo/logs/log_match_admin
EBOT_DEMO_PATH=../../ebot-csgo/demos

# Display mode: "lan" shows server IPs, "net" hides them
EBOT_MODE=net

# Map pool — comma-separated CS2 map names shown during match creation.
# Update this when Valve rotates the active duty pool. No code change or redeploy needed.
# Current pool: ESL Pro Tour 2026 (de_vertigo removed Jan 2026)
# EBOT_MAPS=de_dust2,de_inferno,de_overpass,de_nuke,de_ancient,de_anubis,de_mirage

# Match defaults (ESL Pro Tour 2026 ruleset)
EBOT_DEFAULT_MAX_ROUND=12
EBOT_DEFAULT_RULES=esl_pro_tour
EBOT_DEFAULT_OVERTIME_ENABLE=true
EBOT_DEFAULT_OVERTIME_MAX_ROUND=3
EBOT_DEFAULT_OVERTIME_STARTMONEY=12500

# Demo downloads: true to allow demo file downloads from match pages
EBOT_DEMO_DOWNLOAD=true

# Page refresh interval in seconds (0 to disable)
EBOT_REFRESH_TIME=30

# Toornament API integration
TOORNAMENT_ID=
TOORNAMENT_SECRET=
TOORNAMENT_API_KEY=
TOORNAMENT_PLUGIN_KEY=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
